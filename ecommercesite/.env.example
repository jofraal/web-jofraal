# Archivo de ejemplo para configuración de variables de entorno
# Copiar este archivo a .env y configurar los valores reales

# Variables requeridas para MercadoPago
MERCADOPAGO_PUBLIC_KEY=tu_clave_publica_aqui
MERCADOPAGO_ACCESS_TOKEN=tu_token_de_acceso_aqui

# Variables requeridas para entorno de producción
DJANGO_SECRET_KEY=clave_secreta_django_muy_segura_aqui
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
DATABASE_URL=postgres://usuario:contraseña@host:puerto/nombre_db

# Configuración del entorno
PRODUCTION=True
DEBUG=False

# Variables opcionales
GOOGLE_MAPS_API_KEY=tu_clave_api_google_maps
SENTRY_DSN=https://tu_clave_publica@o123456.ingest.sentry.io/proyecto
CACHE_URL=redis://usuario:contraseña@host:puerto/db
EMAIL_URL=smtp://usuario:contraseña@host:puerto

# Configuración de seguridad adicional
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000  # 1 año
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True